# Copia este archivo como ".env" y completa con tus datos reales de Supabase.
# En el dashboard de Supabase: botón "Connect" (arriba) → pestaña "Session pooler".
# Usa el "Session pooler" (no la conexión directa) para que la app no agote
# el límite de conexiones cuando lleguen varias visitas al formulario a la vez.

DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.tu_project_ref
DB_PASSWORD=tu_contraseña_de_la_base_de_datos

# Fase 6: notificación por correo (Resend — no necesita credenciales de logienter.com)
RESEND_API_KEY=tu_api_key_de_resend
EMAIL_TO=tu_correo_personal_para_pruebas
# El lunes que alguien tenga acceso a hPanel para verificar el dominio,
# cambia EMAIL_TO a canal.etico@logienter.com y listo — no hay que tocar código.

# Fase 7: panel admin (una sola contraseña compartida, sin roles todavía)
ADMIN_PASSWORD=elige_una_contraseña_segura
